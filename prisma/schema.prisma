// Vertex Command Center data model. Money is Decimal(12,2); all times are UTC.

generator client {
  provider   = "prisma-client"
  output     = "../lib/db/generated"
  // workerd has no import.meta.url, which the default (Node) runtime target
  // needs at module load — this is what crashes the Workers deploy.
  runtime    = "workerd"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum CompanyCode {
  VMH
  VTH
}

enum UserKind {
  STAFF
  CLIENT
}

enum MemberRole {
  ADMIN
  MANAGER
  MEMBER
}

enum ClientStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  INACTIVE
}

enum LeadStage {
  NEW
  CONTACTED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  FIVERR
  WEBSITE
  REFERRAL
  LINKEDIN
  EMAIL
  INSTAGRAM
  OTHER
}

enum AlertStatus {
  OPEN
  CONVERTED
  DISMISSED
}

enum ProjectTemplate {
  VMH
  VTH
}

// VMH and VTH share one model; each template uses its own subset (see lib/projects/templates.ts).
enum ProjectStatus {
  NOT_STARTED
  PLANNING
  IN_PROGRESS
  EDITING
  DEVELOPMENT
  IN_REVIEW
  CLIENT_REVIEW
  REVISION
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum WorkCategory {
  VIDEO_EDITING
  WEBSITE_DEVELOPMENT
  CRM_ERP
  AUTOMATION
  DESIGN
  MEETINGS
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum BillingType {
  MONTHLY_RETAINER
  FIXED_SCOPE
  RETAINER_HOURS
  TIME_AND_MATERIALS
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REVISION
}

enum ProductionStage {
  EDITING
  INTERNAL_QC
  CLIENT_REVIEW
  REVISION
  DELIVERED
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  CLIENT_REVIEW
  COMPLETED
}

enum TimeEntryStatus {
  RUNNING
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CARD
  PAYPAL
  WISE
  CASH
  OTHER
}

enum GoalScope {
  COMPANY
  TEAM
  PERSONAL
}

enum GoalCategory {
  REVENUE_SALES
  CLIENT_ACQUISITION
  PROJECT_DELIVERY
  PRODUCT_DEVELOPMENT
  TEAM_HIRING
  PROCESS_AUTOMATION
  CONTENT_CREATION
  CLIENT_SUCCESS
  LEARNING_GROWTH
}

enum GoalMetric {
  MANUAL
  REVENUE
  NEW_CLIENTS
  PROJECTS_COMPLETED
  VIDEOS_DELIVERED
  LEADS_WON
  BILLABLE_HOURS
}

enum GoalUnit {
  CURRENCY
  COUNT
  PERCENT
  HOURS
}

enum GoalStatus {
  ON_TRACK
  AT_RISK
  OFF_TRACK
  COMPLETED
  OVERDUE
}

enum FolderCategory {
  CLIENT_FILES
  PROJECT_FILES
  DESIGN_ASSETS
  VIDEO_ASSETS
  DOCUMENTS
  TEAM_RESOURCES
}

enum FileStatus {
  DRAFT
  REVIEW
  FINAL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
}

enum RecipientStatus {
  QUEUED
  SENT
  OPENED
  REPLIED
  BOUNCED
}

enum EventType {
  CALL
  REVIEW
  FOLLOW_UP
  MEETING
}

enum EntityType {
  LEAD
  CLIENT
  PROJECT
  TASK
  TIME_ENTRY
  INVOICE
  PAYMENT
  GOAL
  FILE
  CAMPAIGN
  APPROVAL
  EVENT
}

// ───────────────────────────── Auth (Better Auth core tables) ─────────────────────────────

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  emailVerified       Boolean   @default(false)
  image               String?
  kind                UserKind  @default(STAFF)
  isOwner             Boolean   @default(false)
  title               String? // e.g. "Owner (Super Admin)", "Video Editor"
  timezone            String    @default("Asia/Kolkata")
  weeklyCapacityHours Int       @default(40)
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions          Session[]
  accounts          Account[]
  memberships       Membership[]
  clientContact     ClientContact?
  ownedClients      Client[]          @relation("ClientOwner")
  ownedLeads        Lead[]            @relation("LeadOwner")
  projectMembers    ProjectMember[]
  assignedTasks     Task[]            @relation("TaskAssignee")
  createdTasks      Task[]            @relation("TaskCreator")
  submittedTasks    Task[]            @relation("TaskReviewFrom")
  checklistItems    ChecklistItem[]
  timeEntries       TimeEntry[]       @relation("TimeEntryUser")
  approvedTime      TimeEntry[]       @relation("TimeEntryApprover")
  payments          Payment[]
  ownedGoals        Goal[]            @relation("GoalOwner")
  goalMembers       GoalMember[]
  uploadedFiles     File[]
  fileVersions      FileVersion[]
  fileShares        FileShare[]
  comments          Comment[]
  activities        Activity[]
  notifications     Notification[]
  notes             Note[]            @relation("NoteAuthor")
  ownedContent      ContentItem[]     @relation("ContentOwner")
  recurringTasks    RecurringTask[]   @relation("RecurringAssignee")
  createdRecurring  RecurringTask[]   @relation("RecurringCreator")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ───────────────────────────── Companies & membership ─────────────────────────────

model Company {
  id                String      @id @default(cuid())
  code              CompanyCode @unique
  name              String
  tagline           String // "Video Editing" / "Web, CRM, ERP, Automation"
  color             String
  logoUrl           String?
  address           String?
  gstin             String?
  invoicePrefix     String
  nextInvoiceNumber Int         @default(1)
  currency          String      @default("INR")
  bankDetails       Json? // { accountName, accountNumber, ifsc, upi }
  // Goal thresholds, workload defaults, revenue basis. Shape: lib/settings.ts
  settings          Json        @default("{}")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  memberships     Membership[]
  clients         ClientCompany[]
  leads           Lead[]
  alertsFrom      CrossSellAlert[] @relation("AlertFrom")
  alertsTo        CrossSellAlert[] @relation("AlertTo")
  projects        Project[]
  tasks           Task[]
  timeEntries     TimeEntry[]
  invoices        Invoice[]
  goals           Goal[]
  folders         Folder[]
  files           File[]
  campaigns       EmailCampaign[]
  events          CalendarEvent[]
  activities      Activity[]
  notes           Note[]
  content         ContentItem[]
  recurringTasks  RecurringTask[]
}

model Membership {
  userId    String
  companyId String
  role      MemberRole @default(MEMBER)
  /// Modules this person may open, overriding the role's defaults. Empty = use the role.
  modules   String[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([userId, companyId])
  @@index([companyId])
}

// ───────────────────────────── Clients & leads ─────────────────────────────

model Client {
  id             String       @id @default(cuid())
  name           String
  domain         String?
  logoUrl        String?
  type           String? // "YouTube Editing", "Custom CRM"…
  status         ClientStatus @default(ACTIVE)
  ownerId        String?
  owner          User?        @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tags           String[]
  notes          String?
  address        String?
  gstin          String?
  currency       String       @default("INR")
  lastActivityAt DateTime     @default(now())
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  companies      ClientCompany[]
  contacts       ClientContact[]
  leads          Lead[]
  crossSell      CrossSellAlert[]
  projects       Project[]
  supportTickets SupportTicket[]
  invoices       Invoice[]
  folders        Folder[]
  files          File[]
  recipients     CampaignRecipient[]
  events         CalendarEvent[]

  @@index([status])
  @@index([ownerId])
  @@index([createdAt])
}

// A client can belong to one or both companies.
model ClientCompany {
  clientId  String
  companyId String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  since     DateTime @default(now())

  @@id([clientId, companyId])
  @@index([companyId])
}

/// Which projects a client contact may see in the portal. Without a row here they see
/// nothing, even with a portal login.
model ProjectContact {
  projectId String
  contactId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contact   ClientContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([projectId, contactId])
  @@index([contactId])
}

model ClientContact {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String
  title        String?
  email        String?
  phone        String?
  timezone     String?
  location     String? // "PST (USA)", "California, USA"
  isPrimary    Boolean  @default(false)
  portalAccess Boolean  @default(false)
  userId       String?  @unique // portal login
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  approvals Approval[]
  shares    FileShare[]
  projects  ProjectContact[]

  @@index([clientId])
}

model Lead {
  id             String     @id @default(cuid())
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id])
  name           String // lead / company name shown on cards
  contactName    String?
  email          String?
  phone          String?
  service        String
  value          Decimal    @db.Decimal(12, 2)
  stage          LeadStage  @default(NEW)
  source         LeadSource @default(OTHER)
  ownerId        String?
  owner          User?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  clientId       String?
  client         Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  position       Int        @default(0)
  notes          String?
  wonAt          DateTime?
  lostAt         DateTime?
  lastActivityAt DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  crossSell  CrossSellAlert[]
  recipients CampaignRecipient[]
  events     CalendarEvent[]

  @@index([companyId, stage])
  @@index([ownerId])
  @@index([clientId])
  @@index([createdAt])
}

model CrossSellAlert {
  id            String      @id @default(cuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromCompanyId String
  fromCompany   Company     @relation("AlertFrom", fields: [fromCompanyId], references: [id])
  toCompanyId   String
  toCompany     Company     @relation("AlertTo", fields: [toCompanyId], references: [id])
  reason        String
  rule          String // which rule raised it, so the same alert isn't raised twice
  status        AlertStatus @default(OPEN)
  leadId        String?
  lead          Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([clientId, toCompanyId, rule])
  @@index([status])
}

// ───────────────────────────── Projects ─────────────────────────────

model Project {
  id            String          @id @default(cuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id])
  clientId      String? // null = internal project ("VTH Internal")
  client        Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  summary       String? // one-line description under the title
  typeLabel     String // "Short-form Video Editing", "Custom CRM Development"
  category      WorkCategory
  template      ProjectTemplate
  status        ProjectStatus   @default(NOT_STARTED)
  priority      Priority        @default(MEDIUM)
  value         Decimal         @default(0) @db.Decimal(12, 2)
  billingType   BillingType
  retainerHours Int?
  startDate     DateTime
  dueDate       DateTime?
  completedAt   DateTime?
  progress      Int             @default(0) // cached; recomputed by lib/projects/progress.ts
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  members        ProjectMember[]
  deliverables   Deliverable[]
  milestones     Milestone[]
  phases         TimelinePhase[]
  approvals      Approval[]
  bugs           Bug[]
  supportTickets SupportTicket[]
  tasks          Task[]
  timeEntries    TimeEntry[]
  invoices       Invoice[]
  folders        Folder[]
  files          File[]
  events         CalendarEvent[]
  recurringTasks RecurringTask[]
  portalContacts ProjectContact[]

  @@index([companyId, status])
  @@index([clientId])
  @@index([dueDate])
}

model ProjectMember {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

// VMH: counts ("8 / 12", reset per billing cycle). VTH: percent.
model Deliverable {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  targetCount    Int?
  completedCount Int?
  percent        Int?
  cycleMonth     DateTime? // first day of the billing month for retainer deliverables
  order          Int       @default(0)

  @@index([projectId])
}

model Milestone {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime
  status    MilestoneStatus @default(PENDING)
  order     Int             @default(0)

  @@index([projectId])
  @@index([dueDate])
}

model TimelinePhase {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  date      DateTime
  status    MilestoneStatus @default(PENDING)
  order     Int             @default(0)

  @@index([projectId])
}

model Approval {
  id                   String         @id @default(cuid())
  projectId            String
  project              Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                String // deliverable title, e.g. "Short #1"
  fileId               String?
  file                 File?          @relation(fields: [fileId], references: [id], onDelete: SetNull)
  status               ApprovalStatus @default(PENDING)
  requestedAt          DateTime       @default(now())
  respondedAt          DateTime?
  respondedByContactId String?
  respondedBy          ClientContact? @relation(fields: [respondedByContactId], references: [id], onDelete: SetNull)
  comment              String?

  @@index([projectId])
  @@index([status])
}

model Bug {
  id         String      @id @default(cuid())
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  severity   Severity    @default(MEDIUM)
  status     IssueStatus @default(OPEN)
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?

  @@index([projectId, status])
}

model SupportTicket {
  id         String      @id @default(cuid())
  projectId  String?
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title      String
  status     IssueStatus @default(OPEN)
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?

  @@index([clientId, status])
}

// ───────────────────────────── Tasks ─────────────────────────────

model Task {
  id               String           @id @default(cuid())
  companyId        String
  company          Company          @relation(fields: [companyId], references: [id])
  projectId        String?
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  status           TaskStatus       @default(TODO)
  priority         Priority         @default(MEDIUM)
  assigneeId       String?
  assignee         User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?            @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Who handed this up for review, so approving it credits them and sending it back finds them.
  reviewFromId     String?
  reviewFrom       User?            @relation("TaskReviewFrom", fields: [reviewFromId], references: [id], onDelete: SetNull)
  startDate        DateTime?
  dueDate          DateTime?
  completedAt      DateTime?
  estimatedMinutes Int?
  progress         Int              @default(0) // = checklist completion when the task has a checklist
  position         Int              @default(0) // order inside its kanban column
  tags             String[]
  parentId         String?
  parent           Task?            @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks         Task[]           @relation("Subtasks")
  // VMH production board: stage of the video this task produces, with timestamps for turnaround.
  productionStage  ProductionStage?
  editingStartedAt DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  checklist   ChecklistItem[]
  timeEntries TimeEntry[]
  files       File[]

  @@index([companyId, status])
  @@index([assigneeId])
  @@index([projectId])
  @@index([dueDate])
}

model ChecklistItem {
  id         String  @id @default(cuid())
  taskId     String
  task       Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text       String
  done       Boolean @default(false)
  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  order      Int     @default(0)

  @@index([taskId])
}

// ───────────────────────────── Time ─────────────────────────────

model TimeEntry {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id])
  projectId    String?
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId       String?
  task         Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  start        DateTime
  end          DateTime? // null while the timer runs
  durationMin  Int? // set when stopped
  note         String?
  billable     Boolean         @default(true)
  status       TimeEntryStatus @default(PENDING)
  category     WorkCategory? // overrides the project's category (e.g. MEETINGS)
  manual       Boolean         @default(false)
  approvedById String?
  approvedBy   User?           @relation("TimeEntryApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  invoiceId    String?
  invoice      Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, start])
  @@index([companyId, start])
  @@index([projectId])
  @@index([status])
}

// ───────────────────────────── Invoices ─────────────────────────────

model Invoice {
  id         String        @id @default(cuid())
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id])
  number     String // "VMH-021"
  seq        Int
  clientId   String
  client     Client        @relation(fields: [clientId], references: [id])
  projectId  String?
  project    Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  issueDate  DateTime
  dueDate    DateTime
  currency   String        @default("INR")
  subtotal   Decimal       @db.Decimal(12, 2)
  taxRate    Decimal       @default(0) @db.Decimal(5, 2) // percent
  taxAmount  Decimal       @default(0) @db.Decimal(12, 2)
  discount   Decimal       @default(0) @db.Decimal(12, 2)
  total      Decimal       @db.Decimal(12, 2)
  paidAmount Decimal       @default(0) @db.Decimal(12, 2)
  status     InvoiceStatus @default(DRAFT)
  notes      String?
  sentAt     DateTime?
  pdfFileId  String?       @unique
  pdfFile    File?         @relation("InvoicePdf", fields: [pdfFileId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  lineItems   InvoiceLineItem[]
  payments    Payment[]
  timeEntries TimeEntry[]

  @@unique([companyId, seq])
  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@index([issueDate])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  qty         Decimal @db.Decimal(10, 2)
  rate        Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  order       Int     @default(0)

  @@index([invoiceId])
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(12, 2)
  date        DateTime
  method      PaymentMethod
  reference   String?
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([invoiceId])
  @@index([date])
}

// ───────────────────────────── Goals ─────────────────────────────

model Goal {
  id           String       @id @default(cuid())
  companyId    String? // null = both companies ("All")
  company      Company?     @relation(fields: [companyId], references: [id])
  scope        GoalScope
  title        String
  subtitle     String?
  description  String?
  category     GoalCategory
  metricType   GoalMetric   @default(MANUAL)
  unit         GoalUnit     @default(COUNT)
  startValue   Decimal      @default(0) @db.Decimal(14, 2)
  currentValue Decimal      @default(0) @db.Decimal(14, 2)
  targetValue  Decimal      @db.Decimal(14, 2)
  startDate    DateTime
  endDate      DateTime
  ownerId      String
  owner        User         @relation("GoalOwner", fields: [ownerId], references: [id])
  status       GoalStatus   @default(ON_TRACK) // recomputed by lib/metrics/goals.ts
  icon         String? // lucide icon key for the row tile
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  members    GoalMember[]
  milestones GoalMilestone[]

  @@index([companyId])
  @@index([ownerId])
  @@index([endDate])
}

model GoalMember {
  goalId String
  userId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([goalId, userId])
  @@index([userId])
}

model GoalMilestone {
  id     String   @id @default(cuid())
  goalId String
  goal   Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title  String
  date   DateTime
  done   Boolean  @default(false)
  order  Int      @default(0)

  @@index([goalId])
}

// ───────────────────────────── Files ─────────────────────────────

model Folder {
  id        String         @id @default(cuid())
  parentId  String?
  parent    Folder?        @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]       @relation("FolderTree")
  name      String
  category  FolderCategory
  companyId String?
  company   Company?       @relation(fields: [companyId], references: [id])
  clientId  String?
  client    Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  color     String?
  deletedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  files File[]

  @@index([parentId])
  @@index([clientId])
  @@index([projectId])
}

model File {
  id              String      @id @default(cuid())
  folderId        String?
  folder          Folder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name            String
  mime            String
  ext             String // "PDF", "MP4"…
  // shortcut: Int caps one file at ~2 GB; switch to BigInt if raw footage ever exceeds that.
  size            Int
  storageKey      String
  version         Int         @default(1)
  companyId       String?
  company         Company?    @relation(fields: [companyId], references: [id])
  clientId        String?
  client          Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId          String?
  task            Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  uploadedById    String
  uploadedBy      User        @relation(fields: [uploadedById], references: [id])
  status          FileStatus?
  description     String?
  tags            String[]
  // shortcut: one shared star flag, not per user; add a FileStar table if each person needs their own.
  starred         Boolean     @default(false)
  sharedWithPortal Boolean    @default(false)
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  versions   FileVersion[]
  shares     FileShare[]
  approvals  Approval[]
  invoicePdf Invoice?      @relation("InvoicePdf")

  @@index([folderId])
  @@index([clientId])
  @@index([projectId])
  @@index([taskId])
  @@index([deletedAt])
}

model FileVersion {
  id           String   @id @default(cuid())
  fileId       String
  file         File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  version      Int
  storageKey   String
  size         Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([fileId, version])
}

model FileShare {
  id              String         @id @default(cuid())
  fileId          String
  file            File           @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientContactId String?
  clientContact   ClientContact? @relation(fields: [clientContactId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([userId])
}

// ───────────────────────────── Campaigns, calendar ─────────────────────────────

model EmailCampaign {
  id             String         @id @default(cuid())
  companyId      String? // null = both companies
  company        Company?       @relation(fields: [companyId], references: [id])
  name           String
  status         CampaignStatus @default(DRAFT)
  subject        String
  audienceFilter Json           @default("{}")
  steps          Json           @default("[]") // [{ subject, body, delayDays }]
  // Counters updated by the sender/tracker so list views don't scan every recipient.
  sentCount      Int            @default(0)
  openCount      Int            @default(0)
  replyCount     Int            @default(0)
  meetingsCount  Int            @default(0)
  scheduledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  recipients CampaignRecipient[]

  @@index([companyId, status])
}

model CampaignRecipient {
  id              String          @id @default(cuid())
  campaignId      String
  campaign        EmailCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email           String
  name            String?
  leadId          String?
  lead            Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clientId        String?
  client          Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  status          RecipientStatus @default(QUEUED)
  step            Int             @default(0)
  sentAt          DateTime?
  openedAt        DateTime?
  repliedAt       DateTime?
  meetingBookedAt DateTime?

  @@unique([campaignId, email])
  @@index([status])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  companyId   String? // null = both companies (e.g. Team Sync)
  company     Company?  @relation(fields: [companyId], references: [id])
  title       String
  type        EventType
  start       DateTime
  end         DateTime
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  attendeeIds String[] // user ids
  createdAt   DateTime  @default(now())

  @@index([start])
  @@index([companyId])
}

// ───────────────────────────── Cross-cutting ─────────────────────────────

model Comment {
  id         String     @id @default(cuid())
  entityType EntityType
  entityId   String
  authorId   String
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  mentions   String[] // user ids
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId, createdAt])
}

model Activity {
  id         String     @id @default(cuid())
  companyId  String? // null = both companies
  company    Company?   @relation(fields: [companyId], references: [id])
  actorId    String?
  actor      User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  verb       String // "created", "moved", "uploaded", "paid"…
  entityType EntityType
  entityId   String
  summary    String // ready-to-show sentence
  meta       Json?
  createdAt  DateTime   @default(now())

  @@index([companyId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#64748B")
}

// ───────────────────────── Content, notes, routines ─────────────────────────

enum ContentStage {
  IDEA
  SCRIPTING
  FILMING
  EDITING
  SCHEDULED
  PUBLISHED
}

enum ContentChannel {
  YOUTUBE
  INSTAGRAM
  LINKEDIN
  SHORTS
  PODCAST
  OTHER
}

/// Our own content, idea to published. One row per piece; the board columns are the stages.
model ContentItem {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id])
  title       String
  channel     ContentChannel @default(YOUTUBE)
  stage       ContentStage   @default(IDEA)
  ownerId     String?
  owner       User?          @relation("ContentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  hook        String? /// the one line that sells it
  notes       String?
  shootDate   DateTime?
  publishDate DateTime?
  publishedAt DateTime?
  link        String?
  position    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([companyId, stage])
  @@index([publishDate])
}

/// Notebook on the dashboard: short notes kept beside the numbers.
model Note {
  id        String   @id @default(cuid())
  companyId String? /// null = both companies
  company   Company? @relation(fields: [companyId], references: [id])
  authorId  String
  author    User     @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title     String?
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId, pinned, updatedAt])
}

/// A task written once and created fresh for its assignee on each of its weekdays.
model RecurringTask {
  id               String    @id @default(cuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])
  title            String
  assigneeId       String
  assignee         User      @relation("RecurringAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  priority         Priority  @default(MEDIUM)
  estimatedMinutes Int?
  /// ISO weekdays it runs on, 1 = Monday … 7 = Sunday. Empty = every day.
  weekdays         Int[]
  active           Boolean   @default(true)
  /// The IST day it last created a task for, so a day is never doubled up.
  lastRunOn        String?
  createdById      String?
  createdBy        User?     @relation("RecurringCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId, active])
}
