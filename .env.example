# Copy to .env and adjust. Every variable the app reads is listed here.

# ── Database ──────────────────────────────────────────────────────────
# Local: `npm run services` starts an embedded Postgres on this port.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/vertex"

# ── Auth (Better Auth) ────────────────────────────────────────────────
# Long random string (e.g. `openssl rand -base64 32`). Signs sessions and tokens.
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
# Public URL of the app (used in emails and OAuth callbacks).
BETTER_AUTH_URL="http://localhost:3000"
# Optional: Google login appears only when both are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── File storage (any S3-compatible service: AWS S3, Cloudflare R2, local server) ──
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="vertex-files"
S3_ACCESS_KEY_ID="vertexdev"
S3_SECRET_ACCESS_KEY="vertexdev-secret"

# ── Email ─────────────────────────────────────────────────────────────
# Empty = emails are printed to the server console instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="Vertex Command Center <notifications@vertexmediahouse.com>"

# ── Clock ─────────────────────────────────────────────────────────────
# Pins "today" for the seed and the app (YYYY-MM-DD). Set to 2026-10-22 to reproduce the
# design PDF exactly (screenshots, E2E). Leave empty in production to use the real date.
SEED_TODAY="2026-10-22"

# Seeded users' password (all demo accounts). Change before sharing a seeded environment.
SEED_PASSWORD="vertex123"
